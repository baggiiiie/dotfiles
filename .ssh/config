Host *
    # Have ControlMaster do the Right Thing(tm)
    ControlMaster auto
    # Put the socket file here. Optionally create a directory
    # for these and adjust this accordingly.
    ControlPath ~/.ssh/%r@%h:%p
    # If the initial and all other sessions exit, keep the
    # hold controlmaster open for 300 seconds before closing.
    ControlPersist 300s

Host work-mac
  User ydai
  IdentityFile ~/.ssh/baggiiiie-github
  ForwardAgent yes
  IdentitiesOnly yes

Host nuc
  HostName nuc
  User ydai
  ForwardAgent yes
  IdentitiesOnly yes

Match host nuc user root
  IdentityFile ~/.ssh/eos_server_key
  IdentitiesOnly yes

Host omarchy
  HostName omarchy
  User baggiiiie
  ForwardAgent yes
  IdentitiesOnly yes

Host *.edgeos.illumina.com
  User root
  IdentityFile ~/.ssh/eos_server_key
  ForwardAgent yes
  IdentitiesOnly yes

Host github.com
  HostName github.com
  User baggiiiie
  IdentityFile ~/.ssh/baggiiiie-github
  IdentitiesOnly yes

Host git.illumina.com
  HostName git.illumina.com
  User git
  IdentityFile ~/.ssh/baggiiiie-github
  IdentitiesOnly yes
